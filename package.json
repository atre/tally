{
  "name": "tally",
  "version": "0.2.0",
  "description": "Claude Code token telemetry — where do my tokens actually go, per repo/tool/session, plus the hooks that plug the leaks",
  "type": "module",
  "bin": { "tally": "./dist/index.js" },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "prelink": "npm run build",
    "test": "tsc -p tsconfig.test.json && node --test test-dist/test/*.test.js",
    "lint": "tsc --noEmit"
  },
  "keywords": ["claude", "claude-code", "tokens", "telemetry", "cli", "ai"],
  "license": "MIT",
  "private": true,
  "author": "Mykyta Herashchenko",
  "files": ["dist", "skills", "pricing.json"],
  "repository": { "type": "git", "url": "git+https://github.com/atre/tally.git" },
  "homepage": "https://github.com/atre/tally#readme",
  "bugs": { "url": "https://github.com/atre/tally/issues" },
  "engines": { "node": ">=20.0.0" },
  "devDependencies": { "@types/node": "^25.5.0", "typescript": "^5.9.3" }
}
